  "mailer_templates_reauthentication_content": "<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Votre code de vérification</title></head>\n<body style=\"margin:0;padding:0;background:#f3f4f6\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Votre code de vérification Amachia.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f4f6\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:14px;overflow:hidden\">\n<tr><td style=\"background:#18212a;padding:22px 28px\"><img src=\"https://amachia.com/email-logo-amachia.png\" width=\"150\" alt=\"Amachia\" style=\"display:block;border:0;width:150px;height:auto\"></td></tr>\n<tr><td style=\"padding:30px 28px 10px;font-family:Arial,Helvetica,sans-serif;color:#1f2937;font-size:15px;line-height:1.6\">\n<h1 style=\"margin:0 0 14px;font-size:21px;line-height:1.3;color:#111827\">Votre code de vérification</h1>\n<p style=\"margin:0 0 12px\">Bonjour,</p><p style=\"margin:0 0 12px\">Utilisez ce code pour confirmer votre identité :</p><p style=\"margin:18px 0;font-size:30px;font-weight:800;letter-spacing:6px;color:#111827\">{{ .Token }}</p><p style=\"margin:18px 0 0;font-size:13px;color:#6b7280\">Ce code expire rapidement. Ne le communiquez à personne : Amachia ne vous le demandera jamais.</p>\n</td></tr>\n<tr><td style=\"padding:18px 28px 26px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b7280;border-top:1px solid #eef0f2\">\nAmachia — achat en ligne au Cameroun · <a href=\"https://amachia.com\" style=\"color:#6b7280\">amachia.com</a><br>\nCet e-mail est envoyé automatiquement, merci de ne pas y répondre.\n</td></tr>\n</table></td></tr></table></body></html>",
  "mailer_subjects_password_changed_notification": "Votre mot de passe Amachia a été modifié",
  "mailer_templates_password_changed_notification_content": "<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Votre mot de passe a été modifié</title></head>\n<body style=\"margin:0;padding:0;background:#f3f4f6\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Le mot de passe de votre compte a été modifié.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f4f6\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:14px;overflow:hidden\">\n<tr><td style=\"background:#18212a;padding:22px 28px\"><img src=\"https://amachia.com/email-logo-amachia.png\" width=\"150\" alt=\"Amachia\" style=\"display:block;border:0;width:150px;height:auto\"></td></tr>\n<tr><td style=\"padding:30px 28px 10px;font-family:Arial,Helvetica,sans-serif;color:#1f2937;font-size:15px;line-height:1.6\">\n<h1 style=\"margin:0 0 14px;font-size:21px;line-height:1.3;color:#111827\">Votre mot de passe a été modifié</h1>\n<p style=\"margin:0 0 12px\">Bonjour,</p><p style=\"margin:0 0 12px\">Le mot de passe de votre compte Amachia ({{ .Email }}) vient d'être modifié.</p><p style=\"margin:18px 0 0;font-size:13px;color:#6b7280\">Si c'est bien vous, aucune action n'est nécessaire. Sinon, réinitialisez immédiatement votre mot de passe depuis la page de connexion et contactez-nous.</p>\n</td></tr>\n<tr><td style=\"padding:18px 28px 26px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b7280;border-top:1px solid #eef0f2\">\nAmachia — achat en ligne au Cameroun · <a href=\"https://amachia.com\" style=\"color:#6b7280\">amachia.com</a><br>\nCet e-mail est envoyé automatiquement, merci de ne pas y répondre.\n</td></tr>\n</table></td></tr></table></body></html>",
  "mailer_subjects_email_changed_notification": "Votre adresse e-mail Amachia a été modifiée",
  "mailer_templates_email_changed_notification_content": "<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Votre adresse e-mail a été modifiée</title></head>\n<body style=\"margin:0;padding:0;background:#f3f4f6\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">L'adresse e-mail de votre compte a été modifiée.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f4f6\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:14px;overflow:hidden\">\n<tr><td style=\"background:#18212a;padding:22px 28px\"><img src=\"https://amachia.com/email-logo-amachia.png\" width=\"150\" alt=\"Amachia\" style=\"display:block;border:0;width:150px;height:auto\"></td></tr>\n<tr><td style=\"padding:30px 28px 10px;font-family:Arial,Helvetica,sans-serif;color:#1f2937;font-size:15px;line-height:1.6\">\n<h1 style=\"margin:0 0 14px;font-size:21px;line-height:1.3;color:#111827\">Votre adresse e-mail a été modifiée</h1>\n<p style=\"margin:0 0 12px\">Bonjour,</p><p style=\"margin:0 0 12px\">L'adresse e-mail de votre compte Amachia a été remplacée par <strong>{{ .Email }}</strong> (ancienne adresse : {{ .OldEmail }}).</p><p style=\"margin:18px 0 0;font-size:13px;color:#6b7280\">Si vous n'êtes pas à l'origine de ce changement, contactez-nous au plus vite.</p>\n</td></tr>\n<tr><td style=\"padding:18px 28px 26px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b7280;border-top:1px solid #eef0f2\">\nAmachia — achat en ligne au Cameroun · <a href=\"https://amachia.com\" style=\"color:#6b7280\">amachia.com</a><br>\nCet e-mail est envoyé automatiquement, merci de ne pas y répondre.\n</td></tr>\n</table></td></tr></table></body></html>"
