# Public values included at build time. Set them before building.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Private server environment. Never use a VITE_ prefix for these values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI configuration: your own Google AI account, no platform credits.
GOOGLE_API_KEY=
GOOGLE_TEXT_MODEL=gemini-3.1-flash-lite
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

PORT=3000
HOST=0.0.0.0